import common as Cmn;


// Settings
const DEBUG_ENABLED = 0;


// Locations
const L_ANYWHERE = $L("Anywhere");
const L_MAIN = $L("main"); // This is the utility location that bounces around the map where ever it is needed.
const L_BUFFER = $L("createbuffer"); // This is a pre-creation location for creating units and avoiding unplaceable errors if the units cannot be moved to the location after the buffer.
const L_PATHABLE = $L("pathable"); // This is used to move a unit to a position, then check if the unit was offset from the exact position to determine if there is another unit there. The special "pathable" unit is stored at L_PATHABLE.
const L_STAGING = $L("staging"); // This is the location where the main menu is/the staging area for the players.
const L_HEIGHT0 = $L("height0"); // These are used to determine what location height a position is.
const L_HEIGHT1 = $L("height1");
const L_HEIGHT2 = $L("height2");
const L_0X0 = $L("0x0"); // Pixel, can be used also as a secondary version of L_MAIN, if both are needed.
const L_1X1 = $L("1x1"); // 1 tile, 32x32 pixels.
const L_MOUSE = [$L("mouseloc1"), $L("mouseloc2"), $L("mouseloc3"), $L("mouseloc4"), $L("mouseloc5"), $L("mouseloc6"), $L("mouseloc7"), $L("mouseloc8")];
const L_STORAGE = [$L("storage1"), $L("storage2"), $L("storage3"), $L("storage4"), $L("storage5"), $L("storage6"), $L("storage7"), $L("storage8")];


// Units
const U_ANY = 229;
const U_MEN = 230;
const U_HERO = [1, 1, 1, 1, 1, 1, 1, 1]; // hero unit type per player (1 = Terran Ghost)


// Orders
const ORDER_CLOAK = 109;
const ORDER_DECLOAK = 110;


// Game
const MAX_PLAYERS = 8;
const FRAMES_PER_SECOND = 24;
const MOVE_RESET_FRAMES = 4; // frames standing still before move time resets
const SPEED_BASE = 1400; // hero top speed
const SPEED_SPRINT = 2000; // hero top speed while sprinting
const SPRINT_MOVE_FRAMES = 40; // move time needed before sprinting starts
const DODGE_RECHARGE = 120; // frames until dodge can be used again
const DODGE_CLOAK_FRAMES = 12; // frames the hero stays cloaked (dodging) after pressing dodge


// Globals
const screen = StringBuffer();
var elapsed_time = 0; // frames
var players_in_game = 0;


// Player state
const p_in_game = PVariable();
const p_cunit = PVariable(); // hero CUnit, 0 if the player has no hero
const p_pos_x = PVariable(); // hero position as of the last frame
const p_pos_y = PVariable();
const p_move_time = PVariable(); // frames spent moving, reset after MOVE_RESET_FRAMES frames standing still
const p_still_time = PVariable(); // frames since the hero stopped moving
const p_top_speed = PVariable(); // hero top speed, set with set_p_top_speed
const p_dodge_timer = PVariable(); // counts down from DODGE_RECHARGE after dodging, 0 = dodge ready


// Input (set by the MSQC plugin, names must match the MSQC config in EUD Editor)
const mouse_left_down = PVariable();    // MouseDown(LEFT): 1
const mouse_right_down = PVariable();   // MouseDown(RIGHT): 1
const keypress_c = PVariable();         // KeyDown(C): 1
const keypress_d = PVariable();         // KeyDown(D): 1
const keypress_z = PVariable();         // KeyUp(Z): 1
const keypress_x = PVariable();         // KeyUp(X): 1
const keypress_e = PVariable();         // KeyDown(E): 1
const keypress_g = PVariable();         // KeyDown(G): 1, KeyUp(G): 2
const keypress_menu = PVariable();      // KeyUp(L): 1
EUDRegisterObjectToNamespace("mouseleftdown", mouse_left_down);
EUDRegisterObjectToNamespace("mouserightdown", mouse_right_down);
EUDRegisterObjectToNamespace("key_c", keypress_c);
EUDRegisterObjectToNamespace("key_d", keypress_d);
EUDRegisterObjectToNamespace("key_z", keypress_z);
EUDRegisterObjectToNamespace("key_x", keypress_x);
EUDRegisterObjectToNamespace("key_e", keypress_e);
EUDRegisterObjectToNamespace("key_g", keypress_g);
EUDRegisterObjectToNamespace("key_menu", keypress_menu);


function GetMousePosition(playerID) {
    // MSQC moves each player's MouseLoc to their mouse
    const x, y = Cmn.GetLocationPoint(L_MOUSE[playerID]);
    return x, y;
}


// Hero

function HeroIsAlive(playerID) {
    if (p_cunit[playerID] == 0) return 0;
    const unit = CUnit(p_cunit[playerID]);
    if (unit.unitType == U_HERO[playerID] && unit.playerID == playerID && unit.hp > 0) return 1;
    return 0;
}


function RemoveHero(playerID) {
    if (HeroIsAlive(playerID)) {
        const unit = CUnit(p_cunit[playerID]);
        unit.remove();
    }
    p_cunit[playerID] = 0;
}


function set_p_top_speed(playerID, newValue) {
    p_top_speed[playerID] = newValue;
    if (HeroIsAlive(playerID)) {
        const unit = CUnit(p_cunit[playerID]);
        unit.topSpeed = newValue;
    }
}


function SpawnHero(playerID, location) {
    // replaces any existing hero. @return 1 on success, 0 if the hero could not be placed
    RemoveHero(playerID);
    const unit = Cmn.CreateCUnit(U_HERO[playerID], playerID, location);
    p_cunit[playerID] = unit;
    if (unit == 0) return 0;
    const hero = CUnit(p_cunit[playerID]);
    p_pos_x[playerID] = hero.posX; // so the first frame doesn't count as movement
    p_pos_y[playerID] = hero.posY;
    p_move_time[playerID] = 0;
    p_still_time[playerID] = MOVE_RESET_FRAMES;
    set_p_top_speed(playerID, SPEED_BASE);
    p_dodge_timer[playerID] = 0;
    ModifyUnitEnergy(1, U_HERO[playerID], playerID, L_ANYWHERE, 100); // dodge ready
    return 1;
}


function HeroIsDodging(playerID) {
    // true during the first DODGE_CLOAK_FRAMES frames after dodging
    if (p_dodge_timer[playerID] > DODGE_RECHARGE - DODGE_CLOAK_FRAMES) return 1;
    return 0;
}


function onPluginStart() {
    randomize();

    // Initialize Players
    EUDPlayerLoop()();
        const p = getcurpl();
        if (p < MAX_PLAYERS && playerexist(p)) {
            players_in_game++;
            p_in_game[p] = 1;
            for (var i = 0; i < MAX_PLAYERS; i++) {
                SetAllianceStatus(i, Ally); // current player allies player i
            }
            SpawnHero(p, L_1X1); // TODO: temporary test spawn
            CenterView(L_1X1);
        }
    EUDEndPlayerLoop();
}


function afterTriggerExec() {
    // check for players that left
    for (var p = 0; p < MAX_PLAYERS; p++) {
        if (!playerexist(p) && p_in_game[p]) {
            RemoveHero(p);
            p_in_game[p] = 0;
            players_in_game--;
        }
    }

    EUDPlayerLoop()();
        const playerID = getcurpl();
        if (playerID < MAX_PLAYERS && p_in_game[playerID]) {
            if (HeroIsAlive(playerID)) {
                const hero = CUnit(p_cunit[playerID]);
                const hero_x, hero_y = hero.posX, hero.posY;

                // movement: compare against last frame's position
                var is_moving = 0;
                if (hero_x != p_pos_x[playerID] || hero_y != p_pos_y[playerID]) is_moving = 1;
                p_pos_x[playerID] = hero_x;
                p_pos_y[playerID] = hero_y;

                // flingy movement quirk: a unit can get stuck in place with speed left over, clear it
                if (!is_moving && hero.currentSpeed1 > 0) {
                    hero.currentSpeed1 = 0;
                    hero.currentSpeed2 = 0;
                }

                // responsiveness: process new orders immediately instead of waiting for the order timers
                hero.orderTimer = 0;
                hero.orderQueueTimer = 0;

                if (is_moving) {
                    p_move_time[playerID] += 1;
                    p_still_time[playerID] = 0;
                } else if (p_still_time[playerID] < MOVE_RESET_FRAMES) {
                    p_still_time[playerID] += 1;
                    if (p_still_time[playerID] == MOVE_RESET_FRAMES) p_move_time[playerID] = 0;
                }

                // sprint: faster after moving for a while, back to base speed as soon as the hero stops
                var target_speed = SPEED_BASE;
                if (is_moving && p_move_time[playerID] >= SPRINT_MOVE_FRAMES) target_speed = SPEED_SPRINT;
                if (p_top_speed[playerID] != target_speed) set_p_top_speed(playerID, target_speed);

                // dodge: C cloaks the hero for DODGE_CLOAK_FRAMES frames, then recharges
                if (p_dodge_timer[playerID] > 0) {
                    p_dodge_timer[playerID] -= 1;
                    if (p_dodge_timer[playerID] == 0) {
                        DisplayText("\x12\x04DODGE READY!");
                        PlayWAV("staredit/wav/dodge_ready.ogg");
                        ModifyUnitEnergy(1, U_HERO[playerID], playerID, L_ANYWHERE, 100);
                    }
                }
                if (keypress_c[playerID] && p_dodge_timer[playerID] == 0) {
                    p_dodge_timer[playerID] = DODGE_RECHARGE;
                    DisplayText("\x12\x07DODGED!");
                    PlayWAV("staredit/wav/dodge.ogg");
                }
                if (HeroIsDodging(playerID)) Cmn.SetUnitSecondaryOrder(p_cunit[playerID], ORDER_CLOAK);
                else if (Cmn.GetUnitIsCloaked(p_cunit[playerID])) Cmn.SetUnitSecondaryOrder(p_cunit[playerID], ORDER_DECLOAK);
                // energy shows dodge readiness: empty while recharging (held at 0 against natural regen).
                // not emptied during the cloak frames, since cloak drains energy and decloaks at 0.
                if (p_dodge_timer[playerID] > 0 && !HeroIsDodging(playerID)) hero.energy = 0;

                eprintf("move time: {}", p_move_time[playerID]);
            } else {
                // forget the hero once it dies, so p_cunit never points at a reused unit slot
                p_cunit[playerID] = 0;
            }
        }
    EUDEndPlayerLoop();

    elapsed_time++;
}
