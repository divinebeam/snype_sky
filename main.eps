// Entry point: sets up players at map start and runs every system each frame.
// Only this file's onPluginStart / afterTriggerExec are called by the game; the other modules are called from here.
import defs as Def;
import common as Cmn;
import game as Game;
import controls as Controls;
import score as Scoring;
import hero as Hero;
import combat as Combat;
import spawns as Spawn;
import bots as Bot;
import lobby as Lobby;


var elapsed_time = 0; // frames


function UpdateHero(playerID) {
    // everything a living hero does each frame, in order
    const is_moving = Hero.UpdateMovement(playerID);
    Hero.UpdateDash(playerID);
    Hero.UpdateSpeed(playerID, is_moving);
    Hero.UpdateDodge(playerID);
    Combat.UpdateRegen(playerID);
    Combat.UpdateAccuracy(playerID, is_moving);
    Combat.UpdateAttack(playerID);

    if (Def.DEBUG_ENABLED) eprintf("hp: {} | accuracy: {}", Combat.p_hp[playerID], Combat.p_accuracy[playerID]);
}


function onPluginStart() {
    randomize();
    Spawn.CollectSpawnPoints();

    // The game starts in the lobby: humans in their slots, empty slots start as bots if BOTS_ENABLED (the host can
    // toggle them). every slot gets a hero in the staging area.
    const old_cp = getcurpl();
    for (var p = 0; p < Def.MAX_PLAYERS; p++) {
        if (playerexist(p)) Game.AddPlayer(p, 0);
        else if (Def.BOTS_ENABLED) Game.AddPlayer(p, 1);

        setcurpl(p);
        for (var i = 0; i < Def.MAX_PLAYERS; i++) {
            SetAllianceStatus(i, Ally); // current player allies player i
            Cmn.GetVision(i); // current player shares vision with player i
        }
        Lobby.CreateStagingHero(p);
    }
    setcurpl(old_cp);
}


function afterTriggerExec() {
    // check for human players that left (bot slots never "exist")
    for (var p = 0; p < Def.MAX_PLAYERS; p++) {
        if (Game.IsHuman(p) && !playerexist(p)) {
            Hero.Remove(p);
            Game.RemovePlayer(p);
        }
    }

    // every participant, humans and bots (EUDPlayerLoop would skip bot slots).
    // the current player is set to each one, so DisplayText / PlayWAV go to them
    const old_cp = getcurpl();
    for (var playerID = 0; playerID < Def.MAX_PLAYERS; playerID++) {
        if (Game.p_in_game[playerID]) {
            setcurpl(playerID);
            if (Game.game_phase == Game.PHASE_LOBBY) {
                // lobby: humans can move, dash, dodge and shoot (no damage); bots just stand in line
                if (Game.IsHuman(playerID) && Hero.IsAlive(playerID)) {
                    Controls.UpdateInput(playerID);
                    UpdateHero(playerID);
                }
            } else if (Hero.IsAlive(playerID)) {
                if (Game.p_is_bot[playerID]) Bot.Update(playerID);
                else Controls.UpdateInput(playerID);
                UpdateHero(playerID);
            } else if (!Hero.UnitExists(playerID)) {
                // forget the hero if the unit is gone, so p_cunit never points at a reused unit slot
                Hero.p_cunit[playerID] = 0;
            } else {
                Spawn.UpdateRespawn(playerID);
            }
            if (!Game.p_is_bot[playerID]) Scoring.UpdateDisplay(playerID);
        }
    }
    setcurpl(old_cp);

    if (Game.game_phase == Game.PHASE_LOBBY) Lobby.Update();
    else Combat.ResolveDeaths();

    elapsed_time++;
}
